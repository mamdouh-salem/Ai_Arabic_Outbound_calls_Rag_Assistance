# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------- LLM (OpenAI)
OPENAI_API_KEY=
# Model used for the latency-critical in-call turns
OPENAI_CALL_MODEL=gpt-4o-mini
# Model used for reporting, reranking and grounding checks
OPENAI_REASONING_MODEL=
# Embeddings for the KB chunks (3072 dims; must match the pgvector column)
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIM=3072
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
LOCAL_EMBEDDING_DIM=768
GENERATIVE_PROVIDER=gemini
GEMINI_API_KEY=
# ------------------------------------------------------------------- STT (Whisper)
# whisper-1 | gpt-4o-transcribe | gpt-4o-mini-transcribe
STT_MODEL=gpt-4o-transcribe
STT_LANGUAGE=ar
# -------------------------------------------------------------- TTS (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# In-call turns: lowest latency. Static/cached prompts use the quality model below.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_QUALITY_MODEL_ID=eleven_multilingual_v2
# Streaming into Gradio needs raw PCM tuples, not MP3. MP3 is only for the disk cache.
ELEVENLABS_OUTPUT_FORMAT=pcm_16000
# Static prompts are cached to disk as 16 kHz WAV (no ffmpeg/codec dependency)
AUDIO_CACHE_DIR=audio_cache
# ---------------------------------------------------------- Supabase / Postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (used for pgvector queries and the LangGraph checkpointer)
DATABASE_URL=
# ------------------------------------------------------ Observability (LangSmith)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=outbound-ai-arabic
LANGCHAIN_API_KEY=
# ------------------------------------------------------------------- Telephony
# simulated | twilio | Vonage
TELEPHONY_PROVIDER=vonage
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Vonage Keys
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=./vonage_private.key
# ------------------------------------------------------------------------- App
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
GRADIO_PORT=7860
# ----------------------------------------------------------------- RAG tuning
RAG_TOP_K_DENSE=20
RAG_TOP_K_SPARSE=20
RAG_RRF_K=60
RAG_TOP_N_AFTER_RERANK=5
RAG_MIN_GROUNDING_SCORE=0.7
GENERATION_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
GENERATION_MAX_NEW_TOKENS=2048
# ----------------------------------------------------------------- Webhook (dev tunnel)
# Set this to your own ngrok/tunnel URL locally — don't commit a real one
PUBLIC_WEBHOOK_BASE_URL=