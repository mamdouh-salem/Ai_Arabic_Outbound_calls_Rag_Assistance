# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- LLM (OpenAI)
OPENAI_API_KEY=
# Model used for the latency-critical in-call turns
OPENAI_CALL_MODEL=gpt-4o-mini
# Model used for reporting, reranking and grounding checks
OPENAI_REASONING_MODEL=gpt-4o
# Embeddings for the KB chunks (3072 dims; must match the pgvector column)
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIM=3072

# ------------------------------------------------------------------- STT (Whisper)
# whisper-1 | gpt-4o-transcribe | gpt-4o-mini-transcribe
STT_MODEL=gpt-4o-transcribe
STT_LANGUAGE=ar

# -------------------------------------------------------------- TTS (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# ---------------------------------------------------------- Supabase / Postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (used for pgvector queries and the LangGraph checkpointer)
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# ------------------------------------------------------ Observability (LangSmith)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=outbound-ai-arabic
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ------------------------------------------------------------------- Telephony
# simulated | twilio
TELEPHONY_PROVIDER=simulated
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_WEBHOOK_BASE_URL=

# ------------------------------------------------------------------------- App
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
GRADIO_PORT=7860

# ----------------------------------------------------------------- RAG tuning
RAG_TOP_K_DENSE=20
RAG_TOP_K_SPARSE=20
RAG_RRF_K=60
RAG_TOP_N_AFTER_RERANK=5
RAG_MIN_GROUNDING_SCORE=0.7
